{
  "schemaVersion": 1,
  "id": "inventory-searcher",
  "version": "${version}",
  "name": "Inventory Searcher",
  "description": "Opens all containers in reach without their screens and shows their contents in one searchable terminal.",
  "authors": ["Julian0021"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.julian0021.inventorysearcher.InventorySearcherMod"],
    "modmenu": ["io.github.julian0021.inventorysearcher.ModMenuIntegration"]
  },
  "mixins": ["inventory-searcher.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "java": ">=25"
  }
}
